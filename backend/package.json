{
  "name": "law-agent-backend",
  "version": "1.0.0",
  "description": "Identity, organizations and billing for Law Agent. Signs the tokens the AI service verifies.",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "keygen": "tsx src/security/keygen.ts",
    "kid:check": "tsx src/tools/kid-check.ts",
    "typecheck": "tsc --noEmit",
    "webhook:simulate": "tsx src/tools/simulate-webhook.ts",
    "db:check": "tsx src/tools/db-check.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "jose": "^5.10.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
