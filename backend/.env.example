# Copy to backend/.env and fill in. Never commit the real file.
#
# Every value is validated at boot: a missing required variable stops the
# process rather than producing tokens with `iss: undefined` that the AI
# service rejects an hour later for no obvious reason.

# ── database ─────────────────────────────────────────────────────────────
# Two roles. The application role owns nothing, so row-level security
# genuinely applies to it; migrations run as the owner.
# The host is `db` -- the compose service name. Running outside Docker this
# is `localhost` instead. Pointing a container at localhost is the classic
# first-deploy failure: it resolves to the container itself.
DATABASE_URL=postgresql://product_service:CHANGE-ME@db:5432/law_agent
DATABASE_MIGRATE_URL=postgresql://product_owner:CHANGE-ME@db:5432/law_agent

# ── token signing ────────────────────────────────────────────────────────
# This service is the only holder of a private key. Generate with:
#   npm run keygen
# Leave ACTIVE_KID empty in development (newest key wins); set it explicitly
# in production so a rotation is a deliberate config change.
KEYS_DIR=keys
ACTIVE_KID=
JWT_ISSUER=http://127.0.0.1:8001
# A list, not a string: one token is valid at every service that needs it.
JWT_AUDIENCES=law-agent-ai,law-agent-product
# Short, because there is no denylist — expiry is an access token's only
# revocation. The refresh token carries the long session and *is* revocable.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ── the AI service ───────────────────────────────────────────────────────
# Internal network: no reason to leave the host and come back through nginx.
AI_SERVICE_URL=http://ai:8000

# ── pricing ──────────────────────────────────────────────────────────────
# The price of a consultation, in the smallest unit: 50000 = 500.00.
#
# This is the only place it is decided. It used to arrive in the request body,
# which meant the amount charged was whatever the browser said it was.
# `GET /consultations/price` serves this same value so the frontend can label
# its button without holding a second copy that could disagree.
#
# The currency must match what the Paymob account settles in — the gateway is
# ksa.paymob.com, so SAR.
CONSULTATION_PRICE_CENTS=50000
CONSULTATION_CURRENCY=SAR

# ── paymob ───────────────────────────────────────────────────────────────
# Live calls need real credentials. Without them a consultation is still
# created (loudly, without a payment key) so the rest of the flow stays
# testable. PAYMOB_HMAC_SECRET is the webhook's ONLY authentication: a
# callback carries no bearer token, because the gateway does not know our
# users.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# ── maintenance ──────────────────────────────────────────────────────────
# Shared key for the service-to-service endpoints: erasure delivery, and the
# escalation-retry cron. Unset means those refuse to run — fail-closed.
#
# NOT a dashboard credential. People sign in at /auth/login and reach
# /admin/billing/* with an `owner` or `admin` role in their own token; this
# key never belongs in a browser.
ADMIN_API_KEY=

# ── http ─────────────────────────────────────────────────────────────────
PORT=8001
# Compose overrides this to 0.0.0.0: inside a container 127.0.0.1 is the
# container's own loopback. The port is published as 127.0.0.1:8001 on the
# host, so it stays private either way.
BIND_HOST=127.0.0.1
# The real frontend origin before deploying. Localhost only by default.
CORS_ORIGIN_REGEX=^https://tafahom\.thetransformix\.com$
