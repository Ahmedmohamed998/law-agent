# Copy to .env and fill in. Never commit the real file.
#
# This is the AI service's configuration, and it is also the file Docker
# Compose reads for its own variable interpolation — so POSTGRES_PASSWORD
# lives here too.

# ── docker compose ───────────────────────────────────────────────────────
# The Postgres superuser password. Neither service connects as this role;
# they use the application roles created by sql/bootstrap.sql.
POSTGRES_PASSWORD=

# ── database ─────────────────────────────────────────────────────────────
# Two roles, deliberately. The application connects as one with no grant on
# `public` and no ownership, so row-level security genuinely applies to it;
# migrations run as the owner.
#
# The host is `db` — the compose service name. Running outside Docker, this
# is `localhost` instead. Pointing a container at localhost is the classic
# first-deploy failure: it resolves to the container itself.
DATABASE_URL=postgresql+psycopg://ai_service:CHANGE-ME@db:5432/law_agent
DATABASE_MIGRATE_URL=postgresql+psycopg://law_agent_owner:CHANGE-ME@db:5432/law_agent

# ── identity ─────────────────────────────────────────────────────────────
# Verification only. This service never issues a token and never holds a
# signing key.
#
# JWKS is fetched over the internal network — no reason to leave the host and
# come back through nginx. JWT_ISSUER is different: it is compared against the
# `iss` claim the backend signed, so it must be the PUBLIC url.
JWKS_URL=http://backend:8001/.well-known/jwks.json
JWT_ISSUER=https://staging.tafahom.thetransformix.com
JWT_AUDIENCE=law-agent-ai

# Local development only. Makes the bearer token *be* the user id, so anyone
# can read anyone's conversations. It refuses to apply once JWKS_URL is set,
# but leaving it in a production file is a trap for whoever edits it next.
DEV_ALLOW_UNVERIFIED_TOKENS=false

# ── service-to-service ───────────────────────────────────────────────────
# Shared key for /v1/admin/* and erasure. Must match the backend's value.
# Unset means those endpoints refuse to run — an unauthenticated erasure
# endpoint is worse than a missing one.
ADMIN_API_KEY=

# ── cors ─────────────────────────────────────────────────────────────────
# The frontend calls this service directly for chat, because proxying SSE
# buffers it. Anchored with ^ and $ to match the backend, whose regex engine
# does a substring test.
CORS_ORIGIN_REGEX=^https://tafahom\.thetransformix\.com$

# ── binding ──────────────────────────────────────────────────────────────
# Compose overrides this to 0.0.0.0: inside a container 127.0.0.1 is the
# container's own loopback and nothing can reach it. The port is published as
# 127.0.0.1:8000 on the host, so it stays private either way.
BIND_HOST=127.0.0.1
BIND_PORT=8000

# ── azure ────────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=

# ── message allowance ────────────────────────────────────────────────────
# Totals per user across every conversation, never reset. An anonymous
# visitor who signs up keeps the same user id, so 5 anonymous then 15 more
# is a total of 20. owner/admin/lawyer tokens are unlimited.
ANON_MESSAGE_LIMIT=5
REGISTERED_MESSAGE_LIMIT=20

# ── voice ────────────────────────────────────────────────────────────────
# Amazon Transcribe (speech in) and Polly (speech out), with the AWS keys
# above. The IAM user needs transcribe:StartStreamTranscription and
# polly:SynthesizeSpeech; without them voice returns 503 and typed chat is
# unaffected. VOICE_MAX_SECONDS must match the widget, which stops there.
SPEECH_REGION=us-east-1
TRANSCRIBE_LANGUAGE=ar-SA
VOICE_MAX_SECONDS=60
POLLY_VOICE_ID=Zeina
POLLY_ENGINE=standard
POLLY_VOICE_ID_EN=Joanna
POLLY_ENGINE_EN=standard
