# Copy to product/.env and fill in. Never commit the real file.
# Every variable is prefixed PRODUCT_ so it cannot collide with the AI
# service's .env in the same checkout.

# ── database ─────────────────────────────────────────────────────────────
# Two roles: the app owns nothing, migrations run as the owner.
PRODUCT_DATABASE_URL=postgresql+psycopg://product_service:change-me-service@localhost:5432/law_agent
PRODUCT_DATABASE_MIGRATE_URL=postgresql+psycopg://product_owner:change-me-owner@localhost:5432/law_agent

# ── token signing ────────────────────────────────────────────────────────
# Generate with:  python -m product.cli keygen
# Leave PRODUCT_ACTIVE_KID empty in development (newest key wins). Set it
# explicitly in production so a rotation is a deliberate config change.
PRODUCT_ACTIVE_KID=
PRODUCT_JWT_ISSUER=http://127.0.0.1:8001

# ── erasure ──────────────────────────────────────────────────────────────
# Where to tell the AI service that a user exercised erasure.
PRODUCT_AI_SERVICE_URL=http://127.0.0.1:8000

# ── cors ─────────────────────────────────────────────────────────────────
# The real frontend origin before deploying.
PRODUCT_CORS_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# ── maintenance ──────────────────────────────────────────────────────────
# Shared key for /admin (erasure). Unset means those endpoints refuse to run.
PRODUCT_ADMIN_API_KEY=
